# Copia este archivo a ~/.config/standup-bot/config.env (install.sh lo hace) y rellénalo.
# Ese archivo contiene el token del bot: permisos 600 y nunca dentro de un repo.

# --- Telegram (bot personal creado con @BotFather, NO el bot del trabajo)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Git
PROJECTS_DIR=~/Documents
# Todos los emails con los que commiteas (varía según el repo)
GIT_EMAILS=you@personal.com,you@work.com
EXCLUDE_REPOS=standup-bot

# Notas de memoria de Claude Code (solo type: project) modificadas en el periodo
MEMORY_ENABLED=true

# --- GitHub (usa la sesión de `gh`) y Jira (usa la sesión de `acli`)
GITHUB_ENABLED=true
JIRA_ENABLED=true
ACLI_BIN=~/.local/bin/acli
JIRA_JQL=assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC

# --- Resumen con Claude (opcional). Envía mensajes de commit y títulos de tickets
# (nunca diffs) a Anthropic. Verifica que la política de tu empresa lo permite.
LLM_ENABLED=false
CLAUDE_BIN=~/.local/bin/claude
# Vacío = modelo por defecto de tu cuenta. Ej: sonnet (más rápido para algo tan simple)
CLAUDE_MODEL=
