# Copy this file to ~/.config/standup-bot/config.env (install.sh does it) and fill it in.
# That file holds the bot token: keep it at mode 600 and never inside a repo.

# --- Telegram (a personal bot created with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Days off: weekends plus public holidays of ANY of these countries (ISO codes).
# Needs the `holidays` Python package (e.g. `sudo dnf install python3-holidays`).
HOLIDAY_COUNTRIES=US,EC
# Comma-separated YYYY-MM-DD. Use them for holidays moved by decree, company days off,
# or a holiday you work anyway.
EXTRA_DAYS_OFF=
EXTRA_WORKDAYS=

# Skip reports through this date (inclusive), e.g. for vacations: PAUSE_UNTIL=2026-12-31
PAUSE_UNTIL=

# --- Git
PROJECTS_DIR=~/Documents
# Every email you commit with (it may differ per repo)
GIT_EMAILS=you@personal.com,you@work.com
EXCLUDE_REPOS=standup-bot

# Claude Code memory notes (type: project only) modified within the window
MEMORY_ENABLED=true

# --- GitHub (uses your `gh` login) and Jira (uses your `acli` login)
GITHUB_ENABLED=true
JIRA_ENABLED=true
ACLI_BIN=~/.local/bin/acli
JIRA_JQL=assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC

# --- Summary written by Claude (optional). Sends commit subjects, ticket titles and
# memory notes (never diffs) to Anthropic. Check that your employer's policy allows it.
LLM_ENABLED=false
CLAUDE_BIN=~/.local/bin/claude
# Empty = your account's default model. E.g. sonnet (faster for something this simple)
CLAUDE_MODEL=
