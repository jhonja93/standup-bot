[Unit]
Description=Standup bot: every day at 05:00 (local time)

[Timer]
# Every day, not Mon..Fri: the script skips weekends and holidays itself, and
# still sends the birthday greeting on those days.
OnCalendar=*-*-* 05:00
# If the PC was off or suspended at 05:00, run on boot/resume.
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
